# ==========================================
# Telegram Site Management Bot Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Telegram Supergroup Chat ID (Negative integer, e.g. -1001234567890)
SUPERGROUP_CHAT_ID=-1001234567890

# 3. Admin / Site Manager Telegram User IDs (Comma-separated numbers)
# Workers whose IDs are in this list get automatic Admin privileges.
ADMIN_IDS=12345678,87654321

# 4. Access Control: Require Manager Approval for new workers? (True / False)
REQUIRE_APPROVAL=True

# 5. Cutoff Times for Reports (24-hour format)
DAY_CUTOFF_HOUR=19
DAY_CUTOFF_MINUTE=0
NIGHT_CUTOFF_HOUR=7
NIGHT_CUTOFF_MINUTE=0
TIMEZONE=Africa/Addis_Ababa

# 6. Forum Topic Thread IDs (Optional: leave 0 if posting to general group)
# To find thread ID, open Topic in Telegram Desktop/Web -> right click message -> copy link.
TOPIC_PROJECT_ALPHA=2
TOPIC_PROJECT_BETA=5
TOPIC_PROJECT_GAMMA=8
TOPIC_MATERIALS=12
TOPIC_ISSUES=15

# 7. Persistent Cloud Database (Optional: PostgreSQL like Supabase or Neon. If blank, uses local SQLite)
DATABASE_URL=

# 8. Google Sheets Live Webhook URL (Optional: for live sheet sync)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec
